# Copy these values from Cloudinary Console > Settings > API Keys.
# Keep API_SECRET only on the backend; never add it to the frontend.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=vetcare

# The single URL form below can replace the three credential variables above.
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
