# Gửi thông báo cho khách hàng qua Zalo + Gmail: xác nhận lịch hẹn, nhắc lịch hẹn,
# nhắc lịch tiêm phòng, xác nhận/nhắc lịch tái khám, báo đổi/hủy lịch.
#
# NOTIFICATION_PROVIDER=log (mặc định): MỌI kênh chỉ ghi log ở backend, không gửi thật.
# Đổi thành bất kỳ giá trị nào khác (vd. "live") để gửi thật. Kênh nào thiếu cấu hình bên
# dưới sẽ bị đánh dấu FAILED kèm lý do trong bảng notifications - không âm thầm bỏ qua.
NOTIFICATION_PROVIDER=live

# --- Zalo: Zalo Notification Service (ZNS), gửi theo SỐ ĐIỆN THOẠI ---
# Access token của Zalo Official Account (Zalo for Developers > ứng dụng > Official Account API).
ZALO_OA_ACCESS_TOKEN=your-oa-access-token
ZALO_OA_ID=your-oa-id
# Template ZNS đã được Zalo duyệt, khai báo đúng 2 tham số: `title` và `content`
# (mỗi tham số tối đa 400 ký tự - nội dung dài hơn sẽ bị cắt).
ZALO_ZNS_TEMPLATE_ID=your-zns-template-id

# --- Gmail (SMTP) ---
# Với Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password) 16 ký tự,
# KHÔNG dùng mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-clinic@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Phòng khám thú y VetCare <your-clinic@gmail.com>"

# Gửi nhắc lịch hẹn/tái khám trước giờ hẹn bao nhiêu giờ.
APPOINTMENT_REMINDER_LEAD_HOURS=24
# Nhắc lịch tiêm trước ngày đến hạn bao nhiêu ngày (mỗi mũi chỉ nhắc một lần).
VACCINATION_REMINDER_LEAD_DAYS=7
