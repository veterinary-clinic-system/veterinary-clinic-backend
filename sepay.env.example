# SePay uses a bank account linked to VietQR. In sandbox, test delivery with
# the "Giao dịch → Giả lập giao dịch" feature in the SePay dashboard.
PAYMENT_PROVIDER=manual
SEPAY_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
SEPAY_BANK_CODE=YOUR_VIETQR_BANK_CODE
SEPAY_API_KEY=GENERATE_A_LONG_RANDOM_WEBHOOK_KEY
SEPAY_TRANSFER_PREFIX=VETAI
SEPAY_QR_ENDPOINT=https://vietqr.app/img

# Configure this webhook URL in SePay with API Key authentication:
# https://YOUR_PUBLIC_HOST/api/v1/billing/sepay/webhook
