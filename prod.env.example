# Mau bien moi truong cho docker-compose.prod.yml. Tren may chu:
#   cp prod.env.example prod.env && nano prod.env
# prod.env chua bi mat - KHONG commit (da co trong .gitignore).
# Tao chuoi ngau nhien cho mat khau/secret: openssl rand -hex 32
# DB_HOST/REDIS_HOST/PORT do docker-compose.prod.yml tu dat, khong can o day.

API_PREFIX=api/v1
# Domain web tren Cloudflare Pages (nhieu domain cach nhau bang dau phay)
CORS_ORIGIN=https://app.example.com

DB_USERNAME=vetclinic
DB_PASSWORD=
DB_DATABASE=veterinary_clinic
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# AI service (FastAPI) - backend va AI dung chung token nay
AI_PROVIDER=http
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=60000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# De trong de dung mac dinh cua service AI (typesafe/jev-1.14, typesafe/jev-router, 0.5)
OPENROUTER_JEV_MODEL=
OPENROUTER_CHAT_MODEL=
OPENROUTER_DECISIONS_URL=
JEV_SYMPTOM_THRESHOLD=
AI_CORS_ALLOW_ORIGINS=https://app.example.com

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

PAYMENT_PROVIDER=manual
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=MB
SEPAY_API_KEY=
SEPAY_TRANSFER_PREFIX=VETCARE

# log | zalo | gmail ... (xem notification.env.example)
NOTIFICATION_PROVIDER=log
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_ZNS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPOINTMENT_REMINDER_LEAD_HOURS=24
VACCINATION_REMINDER_LEAD_DAYS=3

WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

EXPO_ACCESS_TOKEN=

# Lay o Cloudflare Zero Trust -> Networks -> Tunnels -> (tunnel) -> token
CLOUDFLARE_TUNNEL_TOKEN=
