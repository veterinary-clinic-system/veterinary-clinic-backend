# Mau bien moi truong cho docker-compose.prod.yml. Tren may chu:
#   cp prod.env.example prod.env && nano prod.env
# prod.env chua bi mat - KHONG commit (da co trong .gitignore).
# Tao chuoi ngau nhien cho mat khau/secret: openssl rand -hex 32
# DB_HOST/REDIS_HOST/PORT do docker-compose.prod.yml tu dat, khong can o day.

API_PREFIX=api/v1
# Domain web tren Cloudflare Pages (nhieu domain cach nhau bang dau phay)
CORS_ORIGIN=https://app.example.com

DB_USERNAME=vetclinic
DB_PASSWORD=
DB_DATABASE=veterinary_clinic
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# AI service (FastAPI) - backend va AI dung chung token nay
AI_PROVIDER=http
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=60000
# OpenRouter (bat buoc LLM_API_KEY, tai khoan phai con credit - DeepSeek la model tra phi).
# De trong cac bien con lai de dung mac dinh: https://openrouter.ai/api/v1,
# deepseek/deepseek-v4.1-flash-1017 cho doc anh / du phong / hoi dap.
LLM_BASE_URL=
LLM_API_KEY=
LLM_VISION_MODELS=
LLM_FALLBACK_MODELS=
LLM_CHAT_MODELS=
# Mac dinh JEV_URL=https://openrouter.ai/api/alpha/decisions, JEV_API_KEY=LLM_API_KEY,
# JEV_MODEL=typesafe/jev-1.14
JEV_URL=
JEV_API_KEY=
JEV_MODEL=
JEV_SYMPTOM_THRESHOLD=
# Ten cu, chi duoc doc khi LLM_*/JEV_* o tren de trong
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_JEV_MODEL=
OPENROUTER_DECISIONS_URL=
AI_CORS_ALLOW_ORIGINS=https://app.example.com

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

PAYMENT_PROVIDER=manual
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=MB
SEPAY_API_KEY=
SEPAY_TRANSFER_PREFIX=VETCARE

# log | zalo | gmail ... (xem notification.env.example)
NOTIFICATION_PROVIDER=log
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_ZNS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPOINTMENT_REMINDER_LEAD_HOURS=24
VACCINATION_REMINDER_LEAD_DAYS=3

WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

EXPO_ACCESS_TOKEN=

# Cach dua API ra Internet: cloudfront (AWS, khong can ten mien), ngrok hoac
# cloudflare (can ten mien). Xem dau docker-compose.prod.yml.
COMPOSE_PROFILES=cloudfront
# So proxy dung truoc API: cloudfront = 2 (CloudFront + Caddy), ngrok/cloudflare = 1
TRUST_PROXY=2

# cloudfront: chuoi ngau nhien dai (vd `openssl rand -hex 32`), dien GIONG HET vao
# CloudFront -> Origin -> Add custom header `X-Origin-Verify`. App mobile tro vao
# https://<dxxxx>.cloudfront.net/api/v1 nen KHONG xoa distribution do.
CLOUDFRONT_ORIGIN_SECRET=

# ngrok: dashboard.ngrok.com -> Your Authtoken; Domains -> static domain mien
# phi (vd ten-gi-do.ngrok-free.app). App mobile tro vao
# https://<NGROK_DOMAIN>/api/v1 nen KHONG doi domain nay.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Lay o Cloudflare Zero Trust -> Networks -> Tunnels -> (tunnel) -> token
CLOUDFLARE_TUNNEL_TOKEN=
